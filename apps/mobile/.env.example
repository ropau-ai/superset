# =============================================================================
# @superset/mobile ENV — template for `expo start` in a fresh worktree
#
# Copy to `.env` and fill the values. Values come from an existing configured
# checkout's `apps/mobile/.env` (never from git — real values are not committed).
#
# Source of truth for names + validation: apps/mobile/lib/env.ts (zod schema).
# =============================================================================

# -----------------------------------------------------------------------------
# Required — `expo start` fails schema validation without these
# -----------------------------------------------------------------------------
# Backend API base URL (must be a valid URL).
EXPO_PUBLIC_API_URL=
# Electric sync service base URL (must be a valid URL).
EXPO_PUBLIC_ELECTRIC_URL=
# PostHog project API key.
EXPO_PUBLIC_POSTHOG_KEY=

# -----------------------------------------------------------------------------
# Optional — safe to leave unset (defaults / degraded features noted)
# -----------------------------------------------------------------------------
# Relay base URL for host-service HTTP + WebSocket access (live terminal stream
# + agent activity). Unset: the Live Session screen degrades to a "relay not
# configured" state instead of crashing.
EXPO_PUBLIC_RELAY_URL=
# Web app base URL.
EXPO_PUBLIC_WEB_URL=
# Deep link scheme (default: superset).
EXPO_PUBLIC_DEEP_LINK_SCHEME=
# Deep link domain (unset: no associated domain).
EXPO_PUBLIC_DEEP_LINK_DOMAIN=
# PostHog host (default: https://us.i.posthog.com).
EXPO_PUBLIC_POSTHOG_HOST=
